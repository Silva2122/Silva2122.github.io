# Зеркало старого сайта — 410 МБ, восстанавливается через tools/crawl.mjs
old_version/site/

# Генерируемые артефакты выгрузки
old_version/products.json
old_version/products.md
old_version/categories.json
old_version/_crawl-state.json
old_version/_missing.json

# Сборка и рабочий мусор
dist/
.shots/
node_modules/
# Кэш npm — на сервере HOME указывает в корень проекта (см. deploy/axelnn-admin.service),
# и npm кладёт кэш прямо сюда, а не в домашнюю папку пользователя.
.npm/

# Системное
Thumbs.db
desktop.ini
.DS_Store

# Оригиналы кадров до нормализации
assets/img/catalog-original/

# Вход в админку: логин, хеш пароля и ключ подписи куки.
# Сам content/ в репозиторий идёт — это данные сайта, а этот файл нет.
content/.admin.json

# SMTP-пароль приложения для отправки заказов из корзины на почту.
content/.smtp.json

# OAuth-токен Яндекс.Метрики/Вебмастера — для отчётов и управления целями,
# не для сайта. Заведён 2026-08-31, права metrika:read/write + webmaster:hostinfo/verify.
content/.yandex.json

